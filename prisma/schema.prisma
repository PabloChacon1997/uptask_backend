// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


enum TaskStatus {
  PENDING
  ON_HOLD
  IN_PROGRESS
  UNDER_REVIEW
  COMPLETED
}

model Token {
  id                    String                          @id   @default(uuid()) @db.Uuid
  token                 String                          
  userId                String                          @db.Uuid // Siempre añadir UUID
  user                  User                            @relation(fields: [userId], references: [id])
  created_at            DateTime                        @default(now())
  expires_at            DateTime                        @default(dbgenerated("NOW() + INTERVAL '1 day'"))
}


model Project {
  id                    String                          @id   @default(uuid()) @db.Uuid
  projectName           String
  clientName            String
  description           String                          @db.Text
  created_at            DateTime                        @default(now())
  updated_at            DateTime                        @updatedAt
  managerId             String                          @db.Uuid // Siempre añadir UUID
  manager               User                            @relation(fields: [managerId], references: [id])

  tasks                 Task[]
  team                  ProjectMember[]
}

model Task {
  id                    String                          @id   @default(uuid()) @db.Uuid
  name                  String
  description           String                          @db.Text
  project               Project                         @relation(fields: [projectId], references: [id])
  projectId             String                          @db.Uuid // Siempre añadir UUID
  status                TaskStatus                      @default(PENDING)
  updated_by            String?                         @db.Uuid // Siempre añadir UUID
  user                  User?                           @relation(fields: [updated_by], references: [id])
  created_at            DateTime                        @default(now())
  updated_at            DateTime                        @updatedAt
  history               TaskHistory[]
  notes                 Note[]
}

model User {
  id                    String                          @id   @default(uuid()) @db.Uuid
  email                 String                          @unique
  password              String
  name                  String
  confirmed             Boolean                         @default(false)
  created_at            DateTime                        @default(now())
  updated_at            DateTime                        @updatedAt

  tokens                Token[]
  projects              Project[]
  collaborations        ProjectMember[]
  tasks                 Task[]
  taskHistory           TaskHistory[]
  notes                 Note[]
}

model TaskHistory {
  id                    String                          @id   @default(uuid()) @db.Uuid
  taskId                String                          @db.Uuid
  task                  Task                            @relation(fields: [taskId], references: [id])
  userId                String                          @db.Uuid
  user                  User                            @relation(fields: [userId], references: [id])
  prevStatus            TaskStatus
  newStatus             TaskStatus
  changed_at            DateTime                        @default(now())
}

model ProjectMember {
  id                    String                          @id   @default(uuid()) @db.Uuid
  projectId             String                          @db.Uuid
  userId                String                          @db.Uuid
  joined_at             DateTime                        @default(now())

  project               Project                         @relation(fields: [projectId], references: [id])
  user                  User                            @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
}

model Note {
  id                    String                          @id   @default(uuid()) @db.Uuid
  content               String                          @db.Text
  taskId                String                          @db.Uuid
  task                  Task                            @relation(fields: [taskId], references: [id])
  created_by            String                          @db.Uuid
  creator               User                            @relation(fields: [created_by], references: [id])
  created_at            DateTime                        @default(now())
  updated_at            DateTime                        @updatedAt
}